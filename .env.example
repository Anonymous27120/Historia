# --- Base de données (PostgreSQL) ---
# Créez un projet gratuit sur https://supabase.com ou https://neon.tech
# et collez ici la "Connection string" (mode "pooled" recommandé pour Render).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- IA (obligatoire pour la fonctionnalité "Historia répond") ---
# Par défaut, ce projet utilise Groq (https://console.groq.com/keys),
# 100% gratuit, sans carte bancaire (quota quotidien généreux).
# 1. Créez un compte sur https://console.groq.com
# 2. Générez une clé sur https://console.groq.com/keys et collez-la ici
OPENAI_API_KEY=gsk_...
# Obligatoire avec Groq : indique à l'app d'appeler Groq plutôt qu'OpenAI.
OPENAI_BASE_URL=https://api.groq.com/openai

# Optionnel : change les modèles utilisés.
# Par défaut : llama-3.3-70b-versatile pour le chat, openai/gpt-oss-20b pour
# le quiz (seul modèle Groq gratuit garantissant un JSON strictement conforme).
# HISTORIA_CHAT_MODEL=llama-3.3-70b-versatile
# HISTORIA_QUIZ_MODEL=openai/gpt-oss-20b

# --- Alternative payante : OpenAI officiel ---
# Pour repasser sur l'API OpenAI (payante, https://platform.openai.com/api-keys) :
# retirez la ligne OPENAI_BASE_URL ci-dessus, mettez une clé sk-... dans
# OPENAI_API_KEY, et au besoin HISTORIA_CHAT_MODEL=gpt-4o-mini.

# --- Sécurité ---
# Chaîne aléatoire longue, ex. générée avec: openssl rand -hex 32
JWT_SECRET=change-moi

# --- Identifiants admin (tableau de bord /admin) ---
HISTORIA_ADMIN_USERNAME=Hoel
HISTORIA_ADMIN_PASSWORD=change-moi

NODE_ENV=production
